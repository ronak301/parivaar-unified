{
  "name": "parivaar-web-unified",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "web-admin",
    "mobile"
  ],
  "scripts": {
    "backend:dev": "npm run dev --workspace=backend",
    "admin:dev": "npm run dev --workspace=web-admin",
