# Parivaar web — Vite `import.meta.env` (embedded at build time)
#
# Netlify: Site settings → Environment variables → Import from .env
# (upload this file or paste below; then trigger a new deploy)
#
# Local:  copy to `.env` in this folder (`cp .env.example .env`) and adjust.

VITE_APP_VERSION=1.0.11

# API + media base URL (no trailing slash is OK; app normalizes)
VITE_API_BASE_URL=https://api.parivaarapp.in/

# Production: must be false so dev OTP bypass is off
VITE_ALLOW_OTP_BYPASS=false

# Optional override for dev OTP bypass user id (rarely needed; see authUtils)
# VITE_DEV_OTP_BYPASS_USER_ID=
