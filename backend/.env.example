# MongoDB
MONGODB_URI=mongodb://localhost:27017/parivaar

# Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=30d

# MessageCentral OTP
MESSAGE_CENTRAL_AUTH_TOKEN=your-messagecentral-auth-token
MESSAGE_CENTRAL_CUSTOMER_ID=your-messagecentral-customer-id
MESSAGE_CENTRAL_OTP_LENGTH=6

# Expo Push Notifications
EXPO_ACCESS_TOKEN=your-expo-access-token

# Firebase (for Storage)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Server
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Super Admin (web-admin login)
SUPER_ADMIN_PHONE=your-super-admin-phone
# Generate with: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('yourpassword',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=salt:hash
